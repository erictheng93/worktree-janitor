{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"/path/to/worktree-janitor/scripts/janitor.mjs\" --hook session-start",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"/path/to/worktree-janitor/scripts/janitor.mjs\" --hook post-tool-use",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
