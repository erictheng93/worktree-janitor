{
  "name": "worktree-janitor",
  "version": "0.1.0",
  "description": "Removes git worktrees and local branches whose work is already merged, safely and automatically.",
  "author": { "name": "worktree-janitor contributors" },
  "license": "MIT",
  "keywords": ["git", "worktree", "cleanup", "branches"],
  "skills": "./integrations/codex/plugin-skills/",
  "hooks": {
    "hooks": {
      "SessionStart": [
        {
          "hooks": [
            { "type": "command", "command": "node \"${PLUGIN_ROOT}/scripts/janitor.mjs\" --hook session-start", "timeout": 30 }
          ]
        }
      ],
      "PostToolUse": [
        {
          "matcher": "Bash",
          "hooks": [
            { "type": "command", "command": "node \"${PLUGIN_ROOT}/scripts/janitor.mjs\" --hook post-tool-use", "timeout": 30 }
          ]
        }
      ]
    }
  }
}
