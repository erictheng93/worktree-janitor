{
  // Type checking only: the scripts are plain JavaScript with JSDoc types and
  // run as written (no build step, nothing is emitted). `npm run typecheck`.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "types": ["node"]
  },
  // test/*.mjs is not included yet: test/install.test.mjs imports
  // scripts/install.mjs, which is not annotated, and the janitor suite would
  // need ~140 parameter annotations on fixture helpers for little benefit.
  "include": ["scripts/janitor.mjs"]
}
